# Local development only. Copy this file to .env and fill in real values.
# CI, staging, and production should inject these variables through their
# platform secret/configuration mechanisms instead of mounting .env.
DATABASE_URL=postgres://admin:admin@127.0.0.1:5432/armwrestling-math?sslmode=disable
YOUTUBE_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
INGEST_AUDIO_TIMEOUT=15m

# Optional; the Go command uses the official endpoints when omitted.
YOUTUBE_API_BASE_URL=
OPENAI_API_BASE_URL=

# Optional (MPI-33): self-hosted transcription instead of the OpenAI API.
# TRANSCRIPTION_PROVIDER=whisper_cpp
# WHISPER_SERVER_BASE_URL=http://127.0.0.1:8080
